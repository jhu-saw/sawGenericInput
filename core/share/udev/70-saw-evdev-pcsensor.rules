# Grant the active local seat user access to this pedal's keyboard node only.
# Install in /etc/udev/rules.d, reload rules, then unplug/replug the pedals.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3553", ATTRS{idProduct}=="b001", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess", SYMLINK+="input/saw-pcsensor-pedals"
