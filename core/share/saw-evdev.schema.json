{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sawGenericInput evdev configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device"
  ],
  "properties": {
    "device": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute evdev node or stable symlink"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "vendor_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{4}$"
            },
            "product_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{4}$"
            }
          }
        }
      ]
    },
    "exclusive": {
      "type": "boolean",
      "default": true
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(KEY|BTN)_"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 767
              }
            ]
          },
          "interface": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": [
                "Device",
                "Input"
              ]
            }
          },
          "interfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "Device",
                  "Input"
                ]
              }
            }
          },
          "quick_tap_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 0
          }
        },
        "not": {
          "required": [
            "interface",
            "interfaces"
          ]
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^ABS_",
                "description": "Non-multitouch absolute event code"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 46
              }
            ]
          },
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "center",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "type": "number"
              },
              "center": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "output_minimum": {
                "type": "number"
              },
              "output_center": {
                "type": "number"
              },
              "output_maximum": {
                "type": "number"
              },
              "deadzone": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "buttons"
      ],
      "properties": {
        "buttons": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "axes"
      ],
      "properties": {
        "axes": {
          "minItems": 1
        }
      }
    }
  ]
}
